# Salin file ini jadi .env.local untuk development lokal.
# JANGAN commit .env.local — sudah ada di .gitignore.
# Untuk Vercel, isi variabel yang sama di:
# Project → Settings → Environment Variables

# Opsional — default sudah aman kalau tidak diisi.
NEXT_PUBLIC_APP_URL=https://nala-koe.vercel.app

# WAJIB — Firebase Admin SDK. Tanpa ini, app TIDAK BISA build/jalan
# (validasi env di src/lib/env.ts akan menolak start).
#
# Cara dapatkan nilai ini:
# Firebase Console → Project Settings → Service Accounts →
# "Generate new private key" → download file .json → salin dua field ini:
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@nala-koe.iam.gserviceaccount.com

# PENTING soal format private_key:
# Di file .json yang didownload, "private_key" sudah dalam format
# JSON string dengan \n literal di dalamnya — itu SUDAH format yang benar,
# copy-paste apa adanya (jangan diubah jadi multi-baris sungguhan).
# Contoh bentuknya (nilai di bawah ini BUKAN key asli, cuma contoh bentuk):
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"
